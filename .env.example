# Copy to .env for local development (never commit real secrets).

# Use your local Postgres credentials — do not put production secrets here.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/portal_difal
NEXT_PUBLIC_APP_NAME=Portal Inteligente de DIFAL
PORT=3000

STORAGE_ROOT=./storage

# Optional: enable POST /api/billing/webhook/mock (local/sandbox only).
# Leave unset in production / published hosting so the route stays 404.
# MOCK_BILLING_WEBHOOK_SECRET=
